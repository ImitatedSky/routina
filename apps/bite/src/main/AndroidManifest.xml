<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Bite 不需要任何權限：資料全部在 App 私有目錄，
      備份的匯出／匯入走系統文件選擇器（呼叫端授權單一檔案）。
      這裡刻意不放 <uses-permission>，安裝時使用者不會看到任何權限請求。
    -->

    <application
        android:name=".BiteApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bite">

        <!-- 家族成員標記：Hub 掃描已安裝的 App 時靠這幾個值認出 Bite -->
        <meta-data
            android:name="com.routina.family.member"
            android:value="true" />
        <meta-data
            android:name="com.routina.family.id"
            android:value="bite" />
        <meta-data
            android:name="com.routina.family.name"
            android:value="Routina Bite" />
        <meta-data
            android:name="com.routina.family.summary"
            android:value="熱量飲食紀錄" />
        <meta-data
            android:name="com.routina.family.capabilities"
            android:resource="@xml/family_capabilities" />

        <!--
          singleTop：跳板反覆把今日頁帶到前景時應該重用既有實例，
          而不是在 task 裡一直疊新的。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          能力跳板：家族成員呼叫 Bite 的入口。exported 是必要的（呼叫方是別的 App），
          intent-filter 只收自家命名空間的 action。noHistory + excludeFromRecents
          讓它不留在返回堆疊與最近使用，隱形主題讓使用者看不到它閃一下。
        -->
        <activity
            android:name=".CapabilityActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Bite.Invisible">
            <intent-filter>
                <action android:name="com.routina.family.action.RUN_CAPABILITY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>

</manifest>
